# Free account at https://finnhub.io/register — no credit card needed.
# Used server-side for the US ticker directory, quotes, company profiles and
# fundamentals (P/E, dividend yield, beta).
FINNHUB_API_KEY=

# Same key, exposed to the browser on purpose: Finnhub's real-time trade
# WebSocket is a pure client-side connection (wss://ws.finnhub.io?token=...),
# so the free-tier key is visible in the browser either way. Never put a paid
# or otherwise sensitive key here — only a free-tier Finnhub key.
NEXT_PUBLIC_FINNHUB_API_KEY=

# Postgres connection string (Vercel Postgres / Neon). Used by Prisma for
# accounts, sessions and portfolio holdings. On Vercel, connect a Postgres
# storage integration — it provisions this automatically, so you usually
# don't need to set it by hand locally except for the value below.
#
# Different integrations name this differently. The app also recognizes, in
# priority order: POSTGRES_PRISMA_URL, POSTGRES_URL (pooled, for queries) and
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING (direct, for migrations).
# Whichever your Vercel Postgres/Neon integration sets is enough — you don't
# need to duplicate it as DATABASE_URL too.
DATABASE_URL=

# Random secret used to sign NextAuth session/JWT tokens. Generate one with
# `openssl rand -base64 32`.
AUTH_SECRET=

# OAuth credentials from https://console.cloud.google.com/apis/credentials
# (create an "OAuth client ID" of type "Web application"). Add
# <your-domain>/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API key from https://platform.openai.com/api-keys (an OpenAI key, starts
# with sk-proj- or sk-, not sk-ant-). Used server-side to generate the AI
# Coach panel — Prediction Simulator, Pattern Detection and Risk Meter — from
# each stock's live news, earnings and fundamentals. Without it, the coach
# panel falls back to the static baseline analysis — the rest of the site is
# unaffected. Requires a funded OpenAI account (Billing → add a payment
# method / prepaid credit).
OPENAI_API_KEY=
